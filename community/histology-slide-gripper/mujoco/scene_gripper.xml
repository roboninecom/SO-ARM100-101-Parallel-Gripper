<mujoco model="microscope_slide_gripper">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <include file="gripper_assets.xml"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.27 0.30"
             rgb2="0.32 0.34 0.38" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0.1"/>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.35 0.42 0.52"
             rgb2="0.05 0.06 0.08" width="256" height="256"/>
  </asset>

  <visual>
    <global offwidth="1600" offheight="1200"/>
    <quality shadowsize="4096"/>
  </visual>

  <worldbody>
    <light pos="0.3 -0.4 0.8" dir="-0.3 0.4 -0.8" directional="true" diffuse="0.7 0.7 0.7"/>
    <light pos="-0.4 -0.2 0.6" dir="0.4 0.2 -0.6" diffuse="0.35 0.35 0.35"/>
    <geom name="floor" type="plane" size="0.6 0.6 0.01" material="grid"
          friction="1.0 0.01 0.001"/>

    <!-- gripper held above the bench, jaws pointing down (-Y of the CAD frame -> -Z world) -->
    <body name="sg_mount" pos="0 0 0.1225" euler="90 0 0">
      <joint name="lift" type="slide" axis="0 1 0" range="-0.02 0.30" damping="30"/>
      <include file="gripper_body.xml"/>
    </body>

    <!-- test object: 25 mm across the jaws, tall enough for the 30 mm blades -->
    <body name="slide" pos="0 -0.0285 0.015">
      <freejoint/>
      <geom type="box" size="0.0125 0.010 0.015" rgba="0.75 0.85 0.9 0.9"
            mass="0.010" friction="1.2 0.02 0.005"
            solimp="0.98 0.999 0.001" solref="0.004 1"/>
    </body>
  </worldbody>

  <include file="gripper_actuation.xml"/>

  <!-- testbench only: a vertical axis so the grasp can actually be lifted -->
  <actuator>
    <position name="lift" joint="lift" ctrlrange="-0.02 0.30" kp="4000" kv="200" forcerange="-200 200"/>
  </actuator>
</mujoco>
